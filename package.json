{
  "name": "Quest Veritas",
  "version": "0.0.0",
  "description": "A minimalist personal reading and research library",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder build --win",
    "dist-portable": "electron-builder build --win portable",
    "pack": "electron-builder build --dir"
  },
  "keywords": ["reading", "library", "research", "electron"],
  "author": "Quest Veritas",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "pdfjs-dist": "^3.11.174"
  },
  "build": {
    "appId": "com.questveritas.app",
    "productName": "Quest Veritas",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "node_modules/pdfjs-dist/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        },
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "src/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
