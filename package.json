{
  "name": "quest-veritas",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first reading and research library",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "start": "concurrently -k \"vite --host 127.0.0.1 --port 5174 --strictPort\" \"wait-on http://127.0.0.1:5174 && electron .\"",
    "build": "tsc -b && vite build",
    "dist": "npm run build && electron-builder build --win",
    "dist-portable": "npm run build && electron-builder build --win portable",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.6",
    "@fontsource/manrope": "^5.2.6",
    "@mozilla/readability": "^0.6.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tailwindcss/vite": "^4.1.14",
    "@tiptap/react": "^3.10.7",
    "@tiptap/starter-kit": "^3.10.7",
    "better-sqlite3": "^12.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.44.6",
    "dompurify": "^3.3.0",
    "lucide-react": "^0.545.0",
    "jsdom": "^27.0.1",
    "pdfjs-dist": "^5.4.296",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.12",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.5",
    "electron": "^38.2.2",
    "electron-builder": "^26.0.12",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.9.3",
    "vite": "^7.1.10",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.questveritas.app",
    "productName": "Quest Veritas",
    "directories": { "output": "dist" },
    "files": ["dist/**/*", "electron/main.cjs", "electron/preload.cjs", "drizzle/**/*", "package.json"],
    "win": { "target": ["nsis", "portable"], "icon": "src/assets/icon.ico" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
